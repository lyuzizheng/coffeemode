# ==============================================================================
# CoffeeMode Production Environment Configuration Template
# Architecture: docs/specs/0005-dokploy-vps-and-deployment-architecture.md
# Lifecycle:    docs/devops/LIFECYCLE.md
#
# Dedicated Production stack configuration. Promotes strictly from signed tags (`v*`).
# 100% isolated database, storage bucket, and network from staging.
# Secrets must NEVER be committed to version control.
# ==============================================================================

# --- Web Application & Domains ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
PROD_DOMAIN=coffeemode.app
NEXT_PUBLIC_SITE_URL=https://coffeemode.app
NEXT_PUBLIC_ALLOWED_HOSTS=coffeemode.app,www.coffeemode.app

# --- Database & Storage Isolation (Production) ---
POSTGRES_DB=coffeemode_prod
POSTGRES_USER=coffeemode_prod_user
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_STRONG_PASSWORD
DATABASE_URL=postgresql://coffeemode_prod_user:CHANGE_ME_PRODUCTION_STRONG_PASSWORD@postgres-prod:5432/coffeemode_prod?sslmode=disable

# --- Rate Limiter ---
RATE_LIMIT_BACKEND=memory

# --- Supabase Auth (Production Project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key

# --- Cloudflare Edge & Workers (Production) ---
POI_SERVICE_URL=https://poi-service.your-subdomain.workers.dev
POI_SERVICE_TOKEN=prod-poi-secret-token
IMAGE_SERVICE_URL=https://image-service.your-subdomain.workers.dev
IMAGE_SERVICE_TOKEN=prod-image-secret-token
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.coffeemode.app

# --- Apple MapKit JS (Production Developer Account) ---
APPLE_MAPKIT_TEAM_ID=your-apple-team-id
APPLE_MAPKIT_KEY_ID=your-mapkit-key-id
APPLE_MAPKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- DevOps & Dokploy Automation Webhooks (Production) ---
DOKPLOY_PROD_DEPLOY_URL=https://dokploy.your-server.com/api/deploy/prod-webhook-id
DOKPLOY_PROD_DEPLOY_TOKEN=your-dokploy-prod-token

# --- Cloudflare R2 Backup Replication ---
R2_BACKUP_BUCKET=coffeemode-backups
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Optional Cloudflare API Provisioning ---
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
