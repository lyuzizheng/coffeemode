# CafeMood Staging Environment Configuration Template
# Architecture: docs/specs/0005-dokploy-vps-and-deployment-architecture.md
#
# Copy to Dokploy Staging Application Environment Variables (or .env.staging).
# Staging auto-deploys from `main` branch merges following successful CI gates.
# Secrets must NEVER be committed to version control.

# Canonical public URL of Staging
NEXT_PUBLIC_SITE_URL=https://staging.cafemood.app
APP_ENV=staging
# Allowed hosts for staging redirects and preview ports
NEXT_PUBLIC_ALLOWED_HOSTS=staging.cafemood.app,localhost:3000

# Supabase Auth (Staging Project)
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Staging Postgres (Dokploy VPS `coffeemode-staging-db`, BRAWUKA-507 — moved off
# Supabase staging 2026-09-20 to save Supabase free-tier space).
# App runtime: internal `dokploy-network` connection, same-host overlay, no TLS
# (`sslmode=disable`). Migrations/backups run inside the VPS against the same
# host:port. Secrets live in Dokploy env, not git.
DATABASE_URL=postgresql://coffeemode:CHANGE_ME_STAGING_DB_PASSWORD@postgres-back-up-auxiliary-firewall-16sotd:5432/coffeemode_staging?sslmode=disable
DIRECT_URL=postgresql://coffeemode:CHANGE_ME_STAGING_DB_PASSWORD@postgres-back-up-auxiliary-firewall-16sotd:5432/coffeemode_staging?sslmode=disable

# Rate limits enforce in memory on the single app container (BRAWUKA-378).

# POI Cache Service (Staging Cloudflare Worker)
# Custom domain on the cafemood.app zone (BRAWUKA-236); the workers.dev
# route is retired once the cutover is verified.
POI_SERVICE_URL=https://poi-service-staging.cafemood.app
POI_SERVICE_TOKEN=staging-poi-secret-token

# Image Upload Service (Staging Cloudflare Worker)
IMAGE_SERVICE_URL=https://image-service-staging.cafemood.app
IMAGE_SERVICE_TOKEN=staging-image-secret-token

# Public R2 CDN host for staging images
# Invariant: Must match R2_PUBLIC_HOST_STAGING ("staging-images.cafemood.app") in web/lib/images/constants.ts (BRAWUKA-394)
NEXT_PUBLIC_R2_PUBLIC_URL=https://staging-images.cafemood.app
# Apple MapKit JS (Optional for staging test)
# APPLE_MAPKIT_TEAM_ID=your-apple-team-id
# APPLE_MAPKIT_KEY_ID=your-mapkit-key-id
# APPLE_MAPKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Observability: no log-sink credentials live here. Every error / warn / access
# line goes to stdout (ADR-0004) and `otlp-logs.ts` ships it to Grafana Cloud
# Loki over OTLP, reusing the OTEL_EXPORTER_OTLP_* pair below (BRAWUKA-607).
# The Better Stack ingest sinks were retired 2026-09-21 (BRAWUKA-605).

# Observability: OpenTelemetry traces → Grafana Cloud Tempo (BRAWUKA-606).
# The endpoint and resource attributes are pinned in
# docker-compose.staging.yml; only the credential lives here. Basic auth is
# base64("<instance ID>:<API token>") from the stack's OTLP gateway page
# (Grafana → Connections → OpenTelemetry → Configure). Staging and prod share
# the stack, so the same token works for both — but keep one entry per env file
# so a rotation is a two-file edit, not a hunt.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:token)>

# --- DevOps & Dokploy Automation Webhooks (Staging) ---
# DOKPLOY_STAGING_DEPLOY_URL=https://dokploy.your-server.com/api/deploy/staging-webhook-id
# DOKPLOY_STAGING_DEPLOY_TOKEN=your-dokploy-staging-token
#
# --- Multica Autopilot Webhook (Dokploy cron failure alerting, BRAWUKA-475/476) ---
# When nightly-recompute.sh fails, it POSTs to this webhook to trigger
# CoffeeMode 运维告警自愈 autopilot to create a triage issue.
# MULTICA_AUTOPILOT_WEBHOOK_URL=https://multica.ai/api/webhooks/autopilots/...
# --- Cloudflare Tunnel (BRAWUKA-238; required — compose fail-fast) ---
# CLOUDFLARED_TUNNEL_TOKEN_STAGING=your-cloudflared-tunnel-token-staging
# --- Cloudflare Access Service Token (BRAWUKA-499; for smoke test penetration) ---
# CF_ACCESS_CLIENT_ID=your-cf-access-client-id.access
# CF_ACCESS_CLIENT_SECRET=your-cf-access-client-secret

# --- Cloudflare R2 Backup Replication ---
# R2_BACKUP_BUCKET=coffeemode-backups
# R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
