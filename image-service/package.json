{
  "name": "image-service",
  "version": "1.0.0",
  "description": "CafeMood image upload microservice — Cloudflare Worker that signs presigned R2 URLs.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --env staging --check && node scripts/deploy.mjs --env production --check",
    "lint": "eslint",
    "check:file-size": "node ../scripts/check-service-file-size.mjs",
    "check:suppressions": "node ../web/scripts/check-suppressions.mjs --root .",
    "typecheck": "tsc --noEmit",
    "clean:orphan-originals": "node scripts/clean-orphan-originals.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9",
    "eslint-plugin-sonarjs": "^4.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.119.0"
  }
}
