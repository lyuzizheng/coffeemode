{
  "$schema": "https://dokploy.com/schemas/application-template.json",
  "version": "1.0",
  "description": "CoffeeMode Dokploy Project & Application Architecture Schema (Staging & Production)",
  "projects": [
    {
      "name": "coffeemode-staging",
      "description": "CoffeeMode Staging Environment — Automated CI/CD Webhook Deployments",
      "environment": "staging",
      "applications": [
        {
          "name": "coffeemode-web-staging",
          "appName": "coffeemode-web-staging",
          "description": "Next.js 16 Web Application (Staging)",
          "sourceType": "github",
          "repository": "lyuzizheng/coffeemode",
          "branch": "staging",
          "buildType": "dockerfile",
          "dockerfilePath": "web/Dockerfile",
          "dockerContextPath": "web",
          "autoDeploy": true,
          "ports": [
            {
              "publishedPort": 3000,
              "containerPort": 3000,
              "protocol": "tcp"
            }
          ],
          "domains": [
            {
              "host": "staging.coffeemode.app",
              "https": true,
              "certificate": "letsencrypt",
              "port": 3000
            }
          ],
          "healthCheck": {
            "enabled": true,
            "path": "/api/health",
            "interval": 10,
            "timeout": 3,
            "retries": 5,
            "startPeriod": 15
          },
          "deploy": {
            "replicas": 1,
            "resources": {
              "limits": {
                "cpus": "1.0",
                "memory": "1024M"
              },
              "reservations": {
                "cpus": "0.25",
                "memory": "256M"
              }
            }
          },
          "webhook": {
            "enabled": true,
            "endpoint": "/api/deploy/coffeemode-web-staging",
            "method": "POST",
            "auth": "bearer"
          },
          "envFile": ".env.staging"
        }
      ],
      "databases": [
        {
          "name": "postgres-staging",
          "type": "postgres",
          "dockerImage": "postgis/postgis:16-3.4",
          "databaseName": "coffeemode_staging",
          "databaseUser": "coffeemode_staging_user",
          "network": "coffeemode-staging-network",
          "persistentVolumes": [
            {
              "name": "coffeemode_postgres_staging_data",
              "mountPath": "/var/lib/postgresql/data"
            },
            {
              "name": "coffeemode_postgres_staging_backups",
              "mountPath": "/backups"
            }
          ],
          "backup": {
            "enabled": true,
            "schedule": "0 3 * * *",
            "retentionDays": 7,
            "destination": "local"
          },
          "resources": {
            "limits": {
              "cpus": "1.0",
              "memory": "1536M"
            }
          }
        }
      ]
    },
    {
      "name": "coffeemode-production",
      "description": "CoffeeMode Production Environment — Controlled Promotion from main",
      "environment": "production",
      "applications": [
        {
          "name": "coffeemode-web-prod",
          "appName": "coffeemode-web-prod",
          "description": "Next.js 16 Web Application (Production)",
          "sourceType": "github",
          "repository": "lyuzizheng/coffeemode",
          "branch": "main",
          "buildType": "dockerfile",
          "dockerfilePath": "web/Dockerfile",
          "dockerContextPath": "web",
          "autoDeploy": false,
          "ports": [
            {
              "publishedPort": 3000,
              "containerPort": 3000,
              "protocol": "tcp"
            }
          ],
          "domains": [
            {
              "host": "coffeemode.app",
              "https": true,
              "certificate": "letsencrypt",
              "port": 3000
            },
            {
              "host": "www.coffeemode.app",
              "https": true,
              "certificate": "letsencrypt",
              "port": 3000,
              "redirect": {
                "target": "https://coffeemode.app",
                "permanent": true
              }
            }
          ],
          "healthCheck": {
            "enabled": true,
            "path": "/api/health",
            "interval": 5,
            "timeout": 3,
            "retries": 6,
            "startPeriod": 20
          },
          "deploy": {
            "updateConfig": {
              "order": "start-first",
              "failureAction": "rollback",
              "delay": 5,
              "monitor": 15
            },
            "resources": {
              "limits": {
                "cpus": "2.0",
                "memory": "2048M"
              },
              "reservations": {
                "cpus": "1.0",
                "memory": "1024M"
              }
            }
          },
          "webhook": {
            "enabled": true,
            "endpoint": "/api/deploy/coffeemode-web-prod",
            "method": "POST",
            "auth": "bearer"
          },
          "envFile": ".env.prod"
        }
      ],
      "databases": [
        {
          "name": "postgres-prod",
          "type": "postgres",
          "dockerImage": "postgis/postgis:16-3.4",
          "databaseName": "coffeemode_prod",
          "databaseUser": "coffeemode_prod_user",
          "network": "coffeemode-prod-network",
          "persistentVolumes": [
            {
              "name": "coffeemode_postgres_prod_data",
              "mountPath": "/var/lib/postgresql/data"
            },
            {
              "name": "coffeemode_postgres_prod_backups",
              "mountPath": "/backups"
            }
          ],
          "backup": {
            "enabled": true,
            "schedule": "0 2 * * *",
            "retentionDays": 30,
            "destination": "r2-mirrored",
            "r2Bucket": "coffeemode-backups-prod"
          },
          "resources": {
            "limits": {
              "cpus": "2.0",
              "memory": "4096M"
            },
            "reservations": {
              "cpus": "1.0",
              "memory": "2048M"
            }
          }
        }
      ]
    }
  ]
}
