# ==============================================================================
# CoffeeMode Staging Environment Configuration Template
# Architecture: docs/specs/0005-dokploy-vps-and-deployment-architecture.md
# Lifecycle:    docs/devops/LIFECYCLE.md
#
# Dedicated Staging stack configuration. Staging auto-deploys from main merges.
# 100% isolated database, storage bucket, and network from production.
# Secrets must NEVER be committed to version control.
# ==============================================================================

# --- Web Application & Domains ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
STAGING_DOMAIN=staging.coffeemode.app
NEXT_PUBLIC_SITE_URL=https://staging.coffeemode.app
NEXT_PUBLIC_ALLOWED_HOSTS=staging.coffeemode.app,localhost:3000

# --- Database & Storage Isolation (Staging) ---
POSTGRES_DB=coffeemode_staging
POSTGRES_USER=coffeemode_staging_user
POSTGRES_PASSWORD=CHANGE_ME_STAGING_STRONG_PASSWORD
DATABASE_URL=postgresql://coffeemode_staging_user:CHANGE_ME_STAGING_STRONG_PASSWORD@postgres-staging:5432/coffeemode_staging?sslmode=disable

# --- Rate Limiter ---
RATE_LIMIT_BACKEND=memory

# --- Supabase Auth (Staging Project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# --- Cloudflare Edge & Workers (Staging) ---
POI_SERVICE_URL=https://poi-service-staging.your-subdomain.workers.dev
POI_SERVICE_TOKEN=staging-poi-secret-token
IMAGE_SERVICE_URL=https://image-service-staging.your-subdomain.workers.dev
IMAGE_SERVICE_TOKEN=staging-image-secret-token
NEXT_PUBLIC_R2_PUBLIC_URL=https://staging-images.coffeemode.app

# --- DevOps & Dokploy Automation Webhooks (Staging) ---
DOKPLOY_STAGING_DEPLOY_URL=https://dokploy.your-server.com/api/deploy/staging-webhook-id
DOKPLOY_STAGING_DEPLOY_TOKEN=your-dokploy-staging-token

# --- Cloudflare R2 Backup Replication ---
R2_BACKUP_BUCKET=coffeemode-backups
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Optional Cloudflare API Provisioning ---
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
