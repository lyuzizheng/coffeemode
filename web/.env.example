# CoffeeMode — Supabase is AUTH ONLY (spec 0001).
# Data lives in the self-hosted Postgres; the client never talks to Postgres.

# Supabase project (Dashboard → Settings → API)
# Deployment: add your exact callback URL to
# Dashboard → Authentication → URL Configuration → Redirect URLs
# (e.g. https://your-domain/auth/callback and http://localhost:3000/auth/callback).
# That allowlist is what stops a forged Origin header at OAuth time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-a…-key

# Server-only, reserved for future admin auth ops (e.g. user deletion sync).
# Auth flows use only the anon key. NEVER import in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-s…-key

# Self-hosted Postgres on the VPS.
# Example shape: postgresql://user:***@your-vps:5432/coffeemode?sslmode=require
DATABASE_URL=postgr…word

# Rate limiter backend: "postgres" (shared across instances, default when
# DATABASE_URL is set) or "memory" (single-process/dev). Requires migration
# web/db/migrations/0003_rate_limits.sql for the postgres backend.
# RATE_LIMIT_BACKEND=postgres

# POI cache service (Cloudflare Worker) — server-only, never NEXT_PUBLIC.
# The worker is the ONLY component with a Google Places key; these vars let
# /api/places/* proxy to it. Setup: docs/agent/pending-user-actions.md §7.
POI_SERVICE_URL=https://poi-service.<your-subdomain>.workers.dev
POI_SERVICE_TOKEN=your-poi-service-token

# Image upload service (Cloudflare Worker) — server-only, never NEXT_PUBLIC.
# The worker signs presigned R2 URLs; Next.js /api/images/* proxy to it.
# Setup: docs/agent/pending-user-actions.md §6.
IMAGE_SERVICE_URL=https://image-service.<your-subdomain>.workers.dev
IMAGE_SERVICE_TOKEN=your-image-service-token

# R2 public CDN base for image URLs. No trailing slash.
R2_PUBLIC_URL=https://images.coffeemode.app
