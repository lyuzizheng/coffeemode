# CafeMood — Supabase provides auth (Apple + Google OAuth) AND hosts the main
# Postgres/PostGIS in deployed environments (spec 0001 §Data layer, spec 0010).
# The client never talks to Postgres; route handlers do, server-side.

# Canonical public URL of this deployment. Used for safe OAuth callback URLs
# and other server-side redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional comma-separated allowlist of additional hosts (e.g. staging domains
# or local test ports). The host from NEXT_PUBLIC_SITE_URL is always allowed.
# NEXT_PUBLIC_ALLOWED_HOSTS=localhost:3000,localhost:3001

# Supabase project (Dashboard → Settings → API).
# Add the exact callback URL to Dashboard → Authentication → URL Configuration → Redirect URLs:
#   ${NEXT_PUBLIC_SITE_URL}/auth/callback (and any NEXT_PUBLIC_ALLOWED_HOSTS equivalents).
# Local dev default (spec 0010 S3): the STAGING Supabase project
# (ojujmjewtbquiddswyrg) with real Google OAuth — fill both vars from the
# staging dashboard (keys are public-by-design anon, never service_role).
# Production: NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Offline / unit-test alternative (spec 0010 S3, offline-only): the compose
# supabase-mock on :54321 (or `supabase start` on the same port) issuing
# deterministic fake JWTs (scripts/supabase-mock.mjs +
# web/tests/helpers/auth.ts:fakeJwt). Stop the mock first for `supabase start`:
#   `docker compose stop supabase-mock`.
NEXT_PUBLIC_SUPABASE_URL=https://ojujmjewtbquiddswyrg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key # staging anon key (public by design); paste from Dashboard, never commit real keys

# Server-only, reserved for future admin auth ops (e.g. user deletion sync).
# Auth flows use only the anon key. NEVER import in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-s…-key

# Postgres for app data. Deployed envs: the Supabase project's Postgres via the
# Supavisor pooler (port 6543); migrations/DDL use DIRECT_URL (session :5432) —
# see deploy/dokploy/.env.staging.example. Local default: the compose
# postgis/postgis:16-3.4 container below.
# Example shape: postgresql://user:***@<host>:6543/postgres?sslmode=require
# Supported sslmode values:
#   require | prefer | verify-ca | verify-full — TLS with CA validation (strict, recommended)
#   allow-self-signed                         — TLS without CA validation; explicit opt-in
#                                               for self-signed VPS certs (MITM risk)
#   disable                                   — plaintext (same-host/trusted network only)
# No sslmode means driver default (plaintext unless PGSSLMODE is set).
# Any other value — including an empty one — fails closed (throws).
# Local kit (docker compose): postgres://coffeemode:coffeemode@localhost:5432/coffeemode
# Production example:          postgresql://user:***@<project-pooler-host>:6543/postgres?sslmode=require
DATABASE_URL=postgres://coffeemode:coffeemode@localhost:5432/coffeemode

# POI cache service (Cloudflare Worker) — server-only, never NEXT_PUBLIC.
# The worker is the ONLY component with a Google Places key; these vars let
# /api/places/* proxy to it. Setup: docs/agent/pending-user-actions.md §7.
# Production:   POI_SERVICE_URL=https://poi-service.cafemood.app
#               (staging: https://poi-service-staging.cafemood.app; the
#               workers.dev route is retired after the BRAWUKA-236 cutover)
# Local kit (docker compose, S2): the compose service miniflare-poi exposes
#   http://localhost:8787 on the host and http://miniflare-poi:8787 inside compose.
#   `docker compose up -d --wait` brings it with D1 poi-store + KV poi-cache.
POI_SERVICE_URL=http://localhost:8787
POI_SERVICE_TOKEN=local-dev-token

# Cloudflare Turnstile bot protection for anonymous POST /api/places/resolve
# (BRAWUKA-239; BRAWUKA-233 rejected WAF Managed Challenge here). The widget
# is free with unlimited validations; create one in the Cloudflare dashboard
# (Turnstile → Add widget → domains: cafemood.app, staging.cafemood.app,
# localhost, 127.0.0.1; invisible mode) and wire the keys below. If staging
# sits behind Cloudflare Access, the widget domains must include the Access
# login host too or the challenge cannot load there. Dev/test without the
# keys skip verification (production without TURNSTILE_SECRET_KEY fails closed).
TURNSTILE_SECRET_KEY=
# Public sitekey consumed by the browser widget (NEXT_PUBLIC_* is inlined
# into the client bundle at build time).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Apple MapKit JS search — server-only signing credentials. Apple link import
# and Google search work without these; the Apple provider tab stays disabled
# until the Apple Developer Program key is configured.
APPLE_MAPKIT_TEAM_ID=your-apple-team-id
APPLE_MAPKIT_KEY_ID=your-mapkit-key-id
APPLE_MAPKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# Canonical origin signed into the browser token. Defaults to
# NEXT_PUBLIC_SITE_URL when the override is omitted.
# APPLE_MAPKIT_ORIGIN=https://your-domain.com

# Image upload service (Cloudflare Worker) — server-only, never NEXT_PUBLIC.
# The worker signs presigned R2 URLs; Next.js /api/images/* proxy to it.
# Setup: docs/agent/pending-user-actions.md §6.
# Production:   IMAGE_SERVICE_URL=https://image-service.cafemood.app
#               (staging: https://image-service-staging.cafemood.app)
# Local kit (docker compose, S2): the compose service miniflare-image exposes
#   http://localhost:8788 on the host and http://miniflare-image:8788 inside compose;
#   R2 presigning targets MinIO (R2_ENDPOINT=http://minio:9000).
IMAGE_SERVICE_URL=http://localhost:8788
IMAGE_SERVICE_TOKEN=local-dev-token

# Rate-limit observability (DG129): Better Stack ingest for 429 alerts.
# Leave empty locally (throttled console.warn only). Per environment, set the
# source host + token from the Better Stack dashboard (see docs/agent/pending-user-actions.md §7;
# staging and prod use different sources):
# BETTER_STACK_INGEST_URL=https://<source-host e.g. sXXXX.us-west-2a.betterstackdata.com>
# BETTER_STACK_INGEST_TOKEN=<per-environment source token>

# OpenTelemetry traces → Grafana Cloud Tempo (BRAWUKA-606). One `registerOTel`
# call in `instrumentation.ts` yields traces, the Tempo service map, and the
# `traces_spanmetrics_*` RED metrics the metrics-generator derives from spans.
# Leave the endpoint unset locally: tracing is off, no SDK, no export attempts
# (web/lib/observability/otel.ts). Deployed stacks pin the endpoint and resource
# attributes in deploy/dokploy/docker-compose.{staging,prod}.yml — only the
# credential belongs in the environment:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-southeast-1.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:token)>
# OTEL_RESOURCE_ATTRIBUTES=service.name=coffeemode-web,deployment.environment=staging
# No sampler: head sampling would make `traces_spanmetrics_*` counts a fraction
# of reality (BRAWUKA-605 §6 decision 3, superseded 2026-09-21).

# R2 public CDN base for image URLs. Optional drift guard: when set, the build
# fails unless its host is in R2_ALLOWED_PUBLIC_HOSTS in web/lib/images/constants.ts
# (production: images.cafemood.app, staging: staging-images.cafemood.app per BRAWUKA-394).
# The worker's R2_PUBLIC_URL (image-service/wrangler.toml) must point at the corresponding
# origin — two deploy-time configs, matching host.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.cafemood.app
