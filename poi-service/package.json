{
  "name": "poi-service",
  "version": "1.0.0",
  "description": "CafeMood POI cache microservice — Cloudflare Workers + D1 + KV. Google Places (New) upstream, cached once for the whole app.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint",
    "check:file-size": "node ../scripts/check-service-file-size.mjs",
    "check:suppressions": "node ../web/scripts/check-suppressions.mjs --root .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9",
    "eslint-plugin-sonarjs": "^4.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.119.0"
  }
}
