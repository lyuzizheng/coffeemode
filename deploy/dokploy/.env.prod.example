# CafeMood Production Environment Configuration Template
# Architecture: docs/specs/0005-dokploy-vps-and-deployment-architecture.md
#
# Copy to Dokploy Production Application Environment Variables (or .env.prod).
# Production promotes strictly from signed release tags (`v*`) created on `main`.
# Secrets must NEVER be committed to version control.

# Canonical public URL of Production
NEXT_PUBLIC_SITE_URL=https://cafemood.app
APP_ENV=production
# Allowed hosts for production redirects
NEXT_PUBLIC_ALLOWED_HOSTS=cafemood.app,www.cafemood.app

# Supabase Auth (Production Project)
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key

# Supabase Postgres (Production Project, region ap-southeast-1)
# App runtime: pooled connection (Supavisor transaction mode, port 6543).
# Migrations/backups: DIRECT_URL session/direct connection (port 5432) — DDL must
# never run over the transaction pooler. Secrets live in Dokploy env, not git.
# Note: If password contains special characters (@, /, :, #), URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.CHANGE_ME_PROD_REF:CHANGE_ME_PROD_POOLED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:CHANGE_ME_PROD_DB_PASSWORD@db.CHANGE_ME_PROD_REF.supabase.co:5432/postgres?sslmode=require

# Rate limits enforce in memory on the single app container (BRAWUKA-378).

# POI Cache Service (Production Cloudflare Worker)
# Custom domain on the cafemood.app zone (BRAWUKA-236); the workers.dev
# route is retired once the cutover is verified.
POI_SERVICE_URL=https://poi-service.cafemood.app
POI_SERVICE_TOKEN=prod-poi-strong-token

# Image Upload Service (Production Cloudflare Worker)
IMAGE_SERVICE_URL=https://image-service.cafemood.app
IMAGE_SERVICE_TOKEN=prod-image-strong-token

# Cloudflare Turnstile (BRAWUKA-239/564) — anonymous POST /api/places/resolve.
# Same Managed widget as staging; domains must include cafemood.app +
# www.cafemood.app. Both keys are required: the secret verifies server-side
# (missing → every resolve 403s `bot_verification_failed`), the sitekey is
# inlined into the client bundle at build time via the compose build arg
# (missing → the widget never renders and every resolve 403s
# `turnstile_required`). Redeploy after setting both.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Public R2 CDN host for production images
# Invariant: Must match R2_PUBLIC_HOST_PROD ("images.cafemood.app") in web/lib/images/constants.ts
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.cafemood.app
# Apple MapKit JS (Production Developer Account)
APPLE_MAPKIT_TEAM_ID=your-apple-team-id
APPLE_MAPKIT_KEY_ID=your-mapkit-key-id
APPLE_MAPKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Observability: 429 rate-limit denials are emitted as structured `logWarn`
# lines and shipped to Grafana Cloud Loki over OTLP (BRAWUKA-611). No extra
# env vars — the OTLP gateway credential below is the only observability secret.
# Core health checks and CI/CD remain 100% self-hosted per Spec 0000.

# Observability: OpenTelemetry traces → Grafana Cloud Tempo (BRAWUKA-606).
# The endpoint and resource attributes are pinned in docker-compose.prod.yml;
# only the credential lives here. Basic auth is
# base64("<instance ID>:<API token>") from the stack's OTLP gateway page
# (Grafana → Connections → OpenTelemetry → Configure). Staging and prod share
# the stack, so the same token works for both — but keep one entry per env file
# so a rotation is a two-file edit, not a hunt.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:token)>

# --- DevOps & Dokploy Automation Webhooks (Production) ---
# DOKPLOY_PROD_DEPLOY_URL=https://dokploy.your-server.com/api/deploy/prod-webhook-id
# DOKPLOY_PROD_DEPLOY_TOKEN=your-dokploy-prod-token
#
# --- Multica Autopilot Webhook (Dokploy cron failure alerting, BRAWUKA-475/476) ---
# When nightly-recompute.sh fails, it POSTs to this webhook to trigger
# CoffeeMode 运维告警自愈 autopilot to create a triage issue.
# MULTICA_AUTOPILOT_WEBHOOK_URL=https://multica.ai/api/webhooks/autopilots/...
# --- Cloudflare Tunnel (BRAWUKA-238; required — compose fail-fast) ---
# CLOUDFLARED_TUNNEL_TOKEN_PROD=your-cloudflared-tunnel-token-prod

# --- Cloudflare R2 Backup Replication ---
# R2_BACKUP_BUCKET=coffeemode-backups
# R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
