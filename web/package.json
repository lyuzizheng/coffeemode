{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "recompute:work-stats": "node scripts/recompute-work-stats.mjs",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration/db.integration.test.ts --reporter=verbose",
    "test:integration:images": "RUN_INTEGRATION=1 vitest run --no-file-parallelism tests/integration/images.integration.test.ts tests/integration/orphan-cleanup.integration.test.ts --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:visual": "node scripts/visual-smoke.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "analyze": "next experimental-analyze --output",
    "lhci": "lhci autorun",
    "verify": "npm run check:i18n && npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@heroui/react": "^3.2.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "framer-motion": "^12.43.0",
    "idb-keyval": "^6.3.0",
    "next": "16.3.0",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "sharp": "^0.35.3",
    "tz-lookup": "^6.1.25",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@tanstack/query-persist-client-core": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "aws4fetch": "^1.0.20",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
