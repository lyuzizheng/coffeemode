# CoffeeMode Staging Environment Configuration Template
# Architecture: docs/specs/0005-dokploy-vps-and-deployment-architecture.md
#
# Copy to Dokploy Staging Application Environment Variables (or .env.staging).
# Staging auto-deploys from `main` branch merges following successful CI gates.
# Secrets must NEVER be committed to version control.

# Canonical public URL of Staging
NEXT_PUBLIC_SITE_URL=https://staging.coffeemode.app

# Allowed hosts for staging redirects and preview ports
NEXT_PUBLIC_ALLOWED_HOSTS=staging.coffeemode.app,localhost:3000

# Supabase Auth (Staging Project)
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Self-hosted PostgreSQL + PostGIS (Staging Container inside Dokploy bridge network)
# Note: If password contains special characters (@, /, :, #), URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://coffeemode_staging_user:CHANGE_ME_STAGING_PASSWORD@postgres-staging:5432/coffeemode_staging?sslmode=disable

# Rate limiter backend ("memory" for single staging container, "postgres" for multi-instance)
RATE_LIMIT_BACKEND=memory

# POI Cache Service (Staging Cloudflare Worker)
POI_SERVICE_URL=https://poi-service-staging.your-subdomain.workers.dev
POI_SERVICE_TOKEN=staging-poi-secret-token

# Image Upload Service (Staging Cloudflare Worker)
IMAGE_SERVICE_URL=https://image-service-staging.your-subdomain.workers.dev
IMAGE_SERVICE_TOKEN=staging-image-secret-token

# Public R2 CDN host for staging images
NEXT_PUBLIC_R2_PUBLIC_URL=https://staging-images.coffeemode.app

# Apple MapKit JS (Optional for staging test)
# APPLE_MAPKIT_TEAM_ID=your-apple-team-id
# APPLE_MAPKIT_KEY_ID=your-mapkit-key-id
# APPLE_MAPKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Observability: Optional lightweight Better Stack HTTP log sink for 429 rate-limit alerts (Spec 0001 §DG129).
# Core health checks and CI/CD remain 100% self-hosted per Spec 0000.
# BETTER_STACK_INGEST_URL=https://in.logs.betterstack.com/your-staging-token
